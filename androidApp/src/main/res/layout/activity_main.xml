<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/menu_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/menu_main_bg" />

    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="204dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="36dp"
        android:layout_marginTop="148dp"
        android:background="@drawable/menu_panel_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <Button
            android:id="@+id/menu_start"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/menu_button_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#FFE9F8FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/menu_start"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/menu_button_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#FFE9F8FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/menu_settings"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/menu_exit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/menu_button_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#FFE9F8FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/menu_exit"
            android:textAllCaps="false" />
    </LinearLayout>

    <ImageView
        android:id="@+id/menu_logo"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/menu_logo" />
</FrameLayout>
